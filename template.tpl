___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const localStorage = require('localStorage');
const JSON = require('JSON');
const Object = require('Object');
const copyFromWindow = require('copyFromWindow');
const setInWindow = require('setInWindow');
const generateRandom = require('generateRandom');
const getTimestampMillis = require('getTimestampMillis');
const makeString = require('makeString');
const makeNumber = require('makeNumber');
const getType = require('getType');

// The sandbox doesn't guarantee String.trim, so this removes spaces, tabs and carriage returns.
const trim = function (value) {
  const str = makeString(value);
  let start = 0;
  let end = str.length;
  while (start < end && ' \t\r'.indexOf(str.charAt(start)) > -1) start++;
  while (end > start && ' \t\r'.indexOf(str.charAt(end - 1)) > -1) end--;
  return str.slice(start, end);
};

const STORE = 'mo_purchase_guard';
const PAGE = 'mo_purchase_guard_page';
const MAX_IDS = 100;

const id = trim(data.transactionId || '');
if (!id || id === 'undefined' || id === 'null') return false;

// One ID per page view. A transaction first seen on this page view is never a duplicate here,
// however many times or on whichever dataLayer message Tag Manager evaluates the variable.
let pageId = copyFromWindow(PAGE);
if (!pageId) {
  pageId = makeString(getTimestampMillis()) + '.' + makeString(generateRandom(100000, 999999));
  setInWindow(PAGE, pageId, true);
}

const now = getTimestampMillis();
const days = makeNumber(data.days);
const ttl = (days > 0 ? days : 30) * 86400000;

let seen = JSON.parse(localStorage.getItem(STORE) || '{}');
if (getType(seen) !== 'object') seen = {};

const entry = seen[id];
if (entry && getType(entry.t) === 'number' && now - entry.t < ttl) return entry.p !== pageId;

// First time this ID has been seen: remember it, keeping the newest MAX_IDS that haven't expired.
seen[id] = {t: now, p: pageId};
const ids = [];
const keys = Object.keys(seen);
for (let i = 0; i < keys.length; i++) {
  const item = seen[keys[i]];
  if (item && getType(item.t) === 'number' && now - item.t < ttl) ids.push(keys[i]);
}
const kept = {};
let count = 0;
// Newest first, without relying on Array.sort.
while (count < MAX_IDS && ids.length > 0) {
  let newest = 0;
  for (let i = 1; i < ids.length; i++) if (seen[ids[i]].t > seen[ids[newest]].t) newest = i;
  kept[ids[newest]] = seen[ids[newest]];
  ids.splice(newest, 1);
  count++;
}
localStorage.setItem(STORE, JSON.stringify(kept));
return false;


