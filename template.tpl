___TESTS___

setup: |-
  const store = {};
  const win = {};
  mockObject('localStorage', {getItem: function (k) { return store[k] || null; }, setItem: function (k, v) { store[k] = v; }});
  mock('copyFromWindow', function (k) { return win[k]; });
  mock('setInWindow', function (k, v) { win[k] = v; return true; });
scenarios:
- name: A new transaction isn't a duplicate
  code: |-
    assertThat(runCode({transactionId: 'T1', days: '30'})).isFalse();
- name: The same page view never counts as a duplicate
  code: |-
    assertThat(runCode({transactionId: 'T1', days: '30'})).isFalse();
    assertThat(runCode({transactionId: 'T1', days: '30'})).isFalse();
    assertThat(runCode({transactionId: 'T1', days: '30'})).isFalse();
- name: A refreshed thank-you page is a duplicate
  code: |-
    assertThat(runCode({transactionId: 'T1', days: '30'})).isFalse();
    win.mo_purchase_guard_page = undefined;
    assertThat(runCode({transactionId: 'T1', days: '30'})).isTrue();
    assertThat(runCode({transactionId: 'T1', days: '30'})).isTrue();
- name: A different transaction isn't a duplicate
  code: |-
    assertThat(runCode({transactionId: 'T1', days: '30'})).isFalse();
    win.mo_purchase_guard_page = undefined;
    assertThat(runCode({transactionId: 'T3', days: '30'})).isFalse();
- name: Expired IDs count as new
  code: |-
    let now = 1000000000000;
    mock('getTimestampMillis', function () { return now; });
    assertThat(runCode({transactionId: 'T4', days: '1'})).isFalse();
    win.mo_purchase_guard_page = undefined;
    now = now + 2 * 86400000;
    assertThat(runCode({transactionId: 'T4', days: '1'})).isFalse();
- name: No transaction ID returns false and stores nothing
  code: |-
    assertThat(runCode({transactionId: '', days: '30'})).isFalse();
    assertThat(runCode({transactionId: undefined, days: '30'})).isFalse();
    assertThat(store.mo_purchase_guard).isUndefined();
- name: Storage keeps only the newest 100 IDs
  code: |-
    let now = 1000000000000;
    mock('getTimestampMillis', function () { return now; });
    for (let i = 0; i < 105; i++) { now = now + 1000; runCode({transactionId: 'X' + i, days: '30'}); }
    const saved = store.mo_purchase_guard;
    assertThat(saved.split('"t":').length - 1).isEqualTo(100);
    assertThat(saved.indexOf('"X0"')).isEqualTo(-1);
    assertThat(saved.indexOf('"X104"') > -1).isTrue();
- name: Corrupt storage is ignored
  code: |-
    store.mo_purchase_guard = 'not json';
    assertThat(runCode({transactionId: 'T5', days: '30'})).isFalse();


